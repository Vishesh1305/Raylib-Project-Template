# ----------------------------------------------------------------------
# Generated by Premake: .slnx, .vcxproj, .vcxproj.filters,
# plus Visual Studio's .vcxproj.user and hidden .vs/ folder, which
# VS creates next to the solution (also inside build/)
# ----------------------------------------------------------------------
/build/

# ----------------------------------------------------------------------
# Build output: executables, libraries, .pdb, and Intermediates/
# (.obj, .ilk, .tlog), all produced by MSBuild/compiler/linker
# ----------------------------------------------------------------------
/Binaries/

# ----------------------------------------------------------------------
# Operating system clutter
# ----------------------------------------------------------------------
.DS_Store       # macOS Finder metadata
Thumbs.db       # Windows Explorer thumbnail cache

# ----------------------------------------------------------------------
# Personal editor/IDE state
# Remove the .vscode/ line if you later want to share VS Code settings
# (tasks, launch configs) with everyone who clones the repo
# ----------------------------------------------------------------------
.vscode/
.idea/          # JetBrains Rider/CLion
.vs/